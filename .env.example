# Copy to .env and fill in. All keys are OPTIONAL — the app runs fully offline
# (fallback carbon table + deterministic reasoning) if they are absent.

# Live grid carbon intensity + 24h forecast (https://www.electricitymaps.com/).
ELECTRICITY_MAPS_API_KEY=

# LLM reasoning for the agents. First one set wins (Grafilab > Claude > Gemini),
# else offline. Grafilab Neo Cloud is OpenAI-compatible (hackathon sponsor).
GRAFILAB_API_KEY=
# GRAFILAB_BASE_URL=https://console-api.grafilab.ai/api/oai/v1   # optional override
# GRAFILAB_MODEL=grafilab/qwen3.6-flash                          # optional override
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
