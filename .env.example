# Copy to .env and fill in. All keys are OPTIONAL — the app runs fully offline
# (fallback carbon table + deterministic reasoning) if they are absent.

# Live grid carbon intensity (https://www.electricitymaps.com/). With this set,
# carbon numbers come from the real API and are labeled "live" in the UI.
ELECTRICITY_MAPS_API_KEY=

# LLM reasoning for the agents / ReAct loop. First one set wins; else offline.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
